<Window x:Class="PS4GSCInjector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS4 GSC Injector"
        Width="1180"
        Height="720"
        MinWidth="980"
        MinHeight="620"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="PS4 GSC Injector" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Compile and inject GSC scripts for supported PS4 games."
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right"
                       Text="Created by CGhxst"
                       Foreground="{StaticResource AccentHoverBrush}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Targets" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,10"/>
                    <ListBox x:Name="GameListBox"
                             Grid.Row="1"
                             DisplayMemberPath="DisplayName"
                             SelectionChanged="GameListBox_SelectionChanged"
                             Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="2" Margin="0,0,0,14">
                        <Label Content="Version or mode" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="GameVersionComboBox"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="GameVersionComboBox_SelectionChanged"/>
                    </StackPanel>

                    <TextBlock x:Name="TargetHelpTextBlock"
                               Grid.Row="3"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="IP" Margin="0,0,8,0"/>
                        <TextBox x:Name="Ps4IpTextBox" Grid.Row="0" Grid.Column="1"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Port" Margin="0,0,8,0"/>
                        <TextBox x:Name="Ps4PortTextBox" Grid.Row="0" Grid.Column="4"/>
                        <TextBlock x:Name="PayloadTextBlock"
                                   Grid.Row="0"
                                   Grid.Column="6"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="SendPayloadButton"
                                Grid.Row="0"
                                Grid.Column="7"
                                Content="Send Payload"
                                Style="{StaticResource PrimaryButton}"
                                Click="SendPayloadButton_Click"
                                MinWidth="150"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Status" Margin="0,14,8,0"/>
                        <TextBlock x:Name="ConnectionStatusTextBlock"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="5"
                                   Margin="0,14,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <Button x:Name="AttachGameButton"
                                Grid.Row="1"
                                Grid.Column="7"
                                Content="Attach"
                                Click="AttachGameButton_Click"
                                MinWidth="150"
                                Margin="0,12,0,0"/>
                    </Grid>
                </Border>

                <Border x:Name="CompilerPanel"
                        Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,12">
                            <TextBlock x:Name="CompilerTitleTextBlock" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}"/>
                            <TextBlock x:Name="CompilerHelpTextBlock" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="GSC project" Margin="0,0,12,8"/>
                        <TextBox x:Name="GscProjectFolderTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
                        <Button x:Name="BrowseGscFolderButton" Grid.Row="1" Grid.Column="3" Content="Browse" Click="BrowseGscFolderButton_Click" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Output path" Margin="0,0,12,0"/>
                        <TextBox x:Name="CompiledGscFileOutputTextBox" Grid.Row="2" Grid.Column="1"/>
                        <Button x:Name="BrowseOutputPathButton" Grid.Row="2" Grid.Column="3" Content="Browse" Click="BrowseOutputPathButton_Click"/>

                        <Button x:Name="CompileGscProjectButton"
                                Grid.Row="3"
                                Grid.Column="1"
                                Content="Compile Project"
                                Style="{StaticResource PrimaryButton}"
                                Click="CompileGscProjectButton_Click"
                                Width="220"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,12">
                            <TextBlock x:Name="InjectorTitleTextBlock" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}"/>
                            <TextBlock x:Name="InjectorHelpTextBlock" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Compiled GSC" Margin="0,0,12,0"/>
                        <TextBox x:Name="CompiledGscFileTextBox" Grid.Row="1" Grid.Column="1"/>
                        <Button x:Name="BrowseCompiledGscFileButton" Grid.Row="1" Grid.Column="3" Content="Browse" Click="BrowseCompiledGscFileButton_Click"/>

                        <Button x:Name="InjectGscButton"
                                Grid.Row="2"
                                Grid.Column="1"
                                Content="Inject Script"
                                Style="{StaticResource SuccessButton}"
                                Click="InjectGscButton_Click"
                                Width="220"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="Bundled payload: ps4debug v1.1.19."
                   Foreground="{StaticResource MutedTextBrush}"
                   HorizontalAlignment="Right"
                   Margin="0,12,0,0"/>
    </Grid>
</Window>
